---
import { SITE } from '../config';
import Logo from './Logo.astro';

const path = Astro.url.pathname;
// Exact match only: an article page (/articles/some-post/) must not light up "All Articles".
const norm = (p: string) => (p.length > 1 ? p.replace(/\/+$/, '') : p);
const isActive = (match: string) => norm(path) === (match === '' ? '/' : norm(match));
---

<header class="nav-wrap">
  <div class="frame nav">
    <a class="brand" href="/" aria-label={`${SITE.name} – home`}>
      <Logo />
    </a>

    <div class="tools">
      <nav class="links" id="site-nav" aria-label="Main">
        {
          SITE.nav.map((l) => (
            <a href={l.href} aria-current={isActive(l.match) ? 'page' : undefined}>
              {l.label}
            </a>
          ))
        }
      </nav>

      <button class="toggle" type="button" data-theme-toggle aria-label="Toggle dark mode" aria-pressed="false">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <g transform="translate(2.4 2.4)">
            <path
              d="M7.6 0.6C5.74348 0.6 3.96301 1.3375 2.65025 2.65025C1.3375 3.96301 0.6 5.74348 0.6 7.6C0.6 9.45652 1.3375 11.237 2.65025 12.5497C3.96301 13.8625 5.74348 14.6 7.6 14.6V0.6Z"
              fill="currentColor"
            />
            <path
              d="M14.6 7.6C14.6 11.466 11.466 14.6 7.6 14.6C3.73401 14.6 0.6 11.466 0.6 7.6C0.6 3.73401 3.73401 0.6 7.6 0.6C11.466 0.6 14.6 3.73401 14.6 7.6Z"
              stroke="currentColor"
              stroke-width="1.2"
            />
          </g>
        </svg>
      </button>

      <button class="burger" type="button" data-menu-toggle aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<style>
  .nav-wrap {
    background: var(--surface-default);
  }
  .nav {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: var(--nav-pad-y);
  }
  .brand {
    display: block;
    flex: none;
    width: var(--logo-size);
    height: var(--logo-size);
  }
  .brand :global(.logo) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .links {
    display: flex;
    align-items: center;
    gap: clamp(16px, calc(16px + (100vw - 390px) * 0.0152), 32px);
  }
  .links a {
    font-family: var(--font-ui);
    font-weight: 800;
    font-size: var(--fs-nav);
    line-height: normal;
    color: var(--text-primary);
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition: border-color 0.15s;
  }
  .links a:hover,
  .links a[aria-current='page'] {
    border-bottom-color: currentColor;
  }

  .toggle {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 22px;
    color: var(--icon-default);
    transition: background 0.15s;
  }
  .toggle:hover {
    background: var(--surface-selected);
  }

  .burger {
    display: none;
    flex: none;
    width: 44px;
    height: 44px;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 6px;
  }
  .burger span {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--icon-default);
    transition: transform 0.2s;
  }
  .burger[aria-expanded='true'] span:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  .burger[aria-expanded='true'] span:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  /* Very narrow phones: the three links would crowd the logo → hamburger (guideline). */
  @media (max-width: 349px) {
    .burger {
      display: flex;
    }
    .links {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      z-index: 20;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      padding: 8px var(--pad) 20px;
      background: var(--surface-default);
      border-bottom: 1px solid var(--border-subtle);
    }
    .links.open {
      display: flex;
    }
    .links a {
      width: 100%;
      padding: 12px 0;
      font-size: 18px;
      border-bottom: 0;
    }
    .links a[aria-current='page'] {
      text-decoration: underline;
      text-underline-offset: 6px;
      text-decoration-thickness: 2px;
    }
  }
</style>

<script>
  // Theme toggle (remembers the choice; falls back silently if storage is blocked)
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const sync = () => toggle?.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
  sync();
  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('rgw-theme', next);
    } catch {}
    sync();
  });

  // Hamburger (only visible on very narrow screens)
  const burger = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const links = document.getElementById('site-nav');
  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    links?.classList.toggle('open', !open);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && links?.classList.contains('open')) {
      links.classList.remove('open');
      burger?.setAttribute('aria-expanded', 'false');
      burger?.focus();
    }
  });
</script>
