---
import { SITE } from '../config';
import searchIcon from '../assets/figma/search.svg';
import moon from '../assets/figma/moon.png';

const path = Astro.url.pathname;
const isActive = (match: string) => (match === '' ? path === '/' : path.startsWith(match));
---

<header class="nav">
  <a class="brand" href="/" aria-label={`${SITE.name} – home`}>
    <span class="mark" aria-hidden="true"></span>
    <span class="name">{SITE.shortName}</span>
  </a>

  <nav class="links" aria-label="Main">
    {
      SITE.nav.map((l) => (
        <a href={l.href} aria-current={isActive(l.match) ? 'page' : undefined}>
          {l.label}
        </a>
      ))
    }
  </nav>

  <div class="actions">
    <a class="search" href="/articles/#search" aria-label="Search articles">
      <img class="icon" src={searchIcon.src} width="18" height="18" alt="" />
    </a>
    <button class="toggle" type="button" data-theme-toggle aria-label="Toggle dark mode" aria-pressed="false">
      <img src={moon.src} width="12" height="12" alt="" />
    </button>
    {
      SITE.newsletterEnabled && (
        <a class="subscribe" href={SITE.newsletterUrl}>
          Subscribe
        </a>
      )
    }
    <button class="burger" type="button" data-menu-toggle aria-label="Menu" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span>
    </button>
  </div>

  <nav id="mobile-menu" class="mobile" aria-label="Main (mobile)" hidden>
    {
      SITE.nav.map((l) => (
        <a href={l.href} aria-current={isActive(l.match) ? 'page' : undefined}>
          {l.label}
        </a>
      ))
    }
    {SITE.newsletterEnabled && <a href={SITE.newsletterUrl}>Subscribe</a>}
  </nav>
</header>

<style>
  .nav {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-h);
    padding: 0 var(--pad);
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .mark {
    width: 20px;
    height: 20px;
    background: var(--ink);
  }
  .name {
    font-size: 14px;
    font-weight: 800;
    color: var(--ink);
  }

  .links {
    display: flex;
    align-items: center;
    gap: 30px;
    font-size: 13px;
  }
  .links a {
    color: var(--muted);
    transition: color 0.15s;
  }
  .links a:hover,
  .links a[aria-current='page'] {
    color: var(--ink);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .search {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
  }
  .toggle {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 999px;
    background: var(--toggle-bg);
    border: 1px solid var(--toggle-border);
  }
  .subscribe {
    padding: 9px 16px;
    border-radius: 999px;
    background: var(--btn);
    color: var(--btn-ink);
    font-size: 12px;
    font-weight: 600;
    line-height: 15px;
  }

  .burger {
    display: none;
    width: 32px;
    height: 32px;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    align-items: center;
  }
  .burger span {
    display: block;
    width: 18px;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.2s;
  }
  .burger[aria-expanded='true'] span:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }
  .burger[aria-expanded='true'] span:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
  }

  .mobile {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 20;
    display: flex;
    flex-direction: column;
    padding: 8px var(--pad) 20px;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }
  .mobile[hidden] {
    display: none;
  }
  .mobile a {
    padding: 14px 0;
    font-size: 16px;
    color: var(--muted);
    border-top: 1px solid var(--line);
  }
  .mobile a:first-child {
    border-top: 0;
  }
  .mobile a[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
  }

  @media (max-width: 900px) {
    .nav {
      height: 64px;
    }
    .links {
      display: none;
    }
    .burger {
      display: flex;
    }
    .actions {
      gap: 12px;
    }
  }
  @media (min-width: 901px) {
    .mobile {
      display: none;
    }
  }
</style>

<script>
  // Theme toggle (remembers the choice; falls back silently if storage is blocked)
  const root = document.documentElement;
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const sync = () => toggle?.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
  sync();
  toggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('rgw-theme', next);
    } catch {}
    sync();
  });

  // Mobile menu
  const burger = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu && !menu.hidden) {
      menu.hidden = true;
      burger?.setAttribute('aria-expanded', 'false');
      burger?.focus();
    }
  });
</script>
