---
import { TYPES } from '../config';
import { img } from '../lib/content';
import { longDate } from '../lib/format';
import type { Article } from '../lib/types';

// RGW/Home Article – bordered card used on the home page.
interface Props {
  article: Article;
}
const { article: a } = Astro.props;
const portrait = a.type === 'books';
---

<article class="card">
  <div class="text">
    <div class="meta">
      <span class="tag">{TYPES[a.type].label}</span>
      <span class="when">{a.minutes} min · {longDate(a.date)}</span>
    </div>
    <h3 class="title"><a href={`/articles/${a.slug}/`}>{a.title}</a></h3>
    {a.summary && <p class="summary">{a.summary}</p>}
  </div>
  {
    a.cover && (
      <div class:list={['cover', { portrait }]}>
        <img
          src={img(a.cover.url, portrait ? 360 : 540)}
          alt={a.cover.alt}
          width={portrait ? 120 : 180}
          height={portrait ? 180 : 120}
          style={a.cover.position ? `object-position:${a.cover.position}` : undefined}
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }
</article>

<style>
  .card {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 24px 16px;
    border: 1px solid var(--border-default);
    border-radius: 16px;
    overflow: hidden;
  }
  .text {
    flex: 1 1 auto;
    min-width: 0;
    max-width: 600px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
  }
  .when {
    font-family: var(--font-ui);
    font-size: 12px;
    line-height: normal;
    color: var(--text-primary);
    white-space: nowrap;
  }
  .title {
    font-family: var(--font-read);
    font-weight: 600;
    font-size: 16px;
    line-height: 24px;
    color: var(--text-article);
  }
  /* The whole card is clickable through the title link. */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  .summary {
    font-family: var(--font-read);
    font-size: 14px;
    line-height: 20px;
    color: var(--text-secondary);
  }

  /* Cover stays on the right and shrinks with the card (responsive guideline). */
  .cover {
    flex: none;
    width: var(--cover-w);
    height: var(--cover-w);
    border-radius: 4px;
    overflow: hidden;
    background: var(--surface-subtle);
  }
  .cover.portrait {
    height: var(--cover-h);
  }
  /* Landscape covers: square on phones, 3:2 from tablet up. */
  @media (min-width: 640px) {
    .cover:not(.portrait) {
      width: calc(var(--cover-w) * 1.5);
      height: var(--cover-w);
    }
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .card:hover .cover img {
    transform: scale(1.03);
  }

  @media (min-width: 768px) {
    .card {
      padding: clamp(24px, calc(24px + (100vw - 768px) * 0.0119), 32px) clamp(24px, calc(24px + (100vw - 768px) * 0.0357), 48px);
      gap: 24px;
    }
    .text {
      gap: 10px;
    }
    .title {
      font-size: clamp(18px, calc(18px + (100vw - 768px) * 0.00893), 24px);
      line-height: clamp(26px, calc(26px + (100vw - 768px) * 0.00893), 32px);
    }
    .summary {
      font-size: 16px;
      line-height: 32px;
    }
    .cover {
      border-radius: 12px;
    }
    .cover:not(.portrait) {
      border-radius: 10px;
    }
  }
</style>
