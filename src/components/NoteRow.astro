---
import { TYPES } from '../config';
import { img } from '../lib/content';
import { issueLabel, shortDate } from '../lib/format';
import type { Article } from '../lib/types';

interface Props {
  article: Article;
}
const { article: a } = Astro.props;
const portrait = a.type === 'books';
---

<article class="note">
  <div class="text">
    {a.issue && <p class="issue">{issueLabel(a.issue)}</p>}
    <div class="meta">
      <span class="tag" data-type={a.type}>{TYPES[a.type].label}</span>
      <span class="when">{a.minutes} min · {shortDate(a.date)}</span>
    </div>
    <h3 class="title"><a href={`/articles/${a.slug}/`}>{a.title}</a></h3>
    {a.summary && <p class="summary">{a.summary}</p>}
    {
      a.tags.length > 0 && (
        <ul class="chips" aria-label="Keywords">
          {a.tags.map((t) => (
            <li class="chip">{t}</li>
          ))}
        </ul>
      )
    }
  </div>
  {
    a.cover && (
      <div class:list={['cover', { portrait }]}>
        <img
          src={img(a.cover.url, portrait ? 360 : 540)}
          alt={a.cover.alt}
          width={portrait ? 120 : 180}
          height={portrait ? 180 : 120}
          style={a.cover.position ? `object-position:${a.cover.position}` : undefined}
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }
</article>

<style>
  .note {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    padding: 32px 0;
  }
  .text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
    max-width: 640px;
    min-width: 0;
  }
  .issue {
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    color: var(--muted);
  }
  .meta {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .when {
    font-size: 11px;
    color: var(--faint-2);
  }
  .title {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 22px;
    line-height: 1.45;
    color: var(--ink-2);
  }
  /* The whole card is clickable through the title link. */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .title a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  .summary {
    font-family: var(--font-serif);
    font-size: 14px;
    line-height: 1.75;
    color: var(--muted-2);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .cover {
    flex: none;
    width: 180px;
    height: 120px;
    border-radius: 10px;
    overflow: hidden;
    background: var(--chip);
  }
  .cover.portrait {
    width: 120px;
    height: 180px;
    border-radius: 12px;
  }
  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .note:hover .cover img {
    transform: scale(1.03);
  }

  @media (max-width: 640px) {
    .note {
      align-items: flex-start;
      gap: 16px;
      padding: 24px 0;
    }
    .title {
      font-size: 19px;
    }
    .cover {
      width: 96px;
      height: 64px;
    }
    .cover.portrait {
      width: 72px;
      height: 108px;
    }
  }
</style>
