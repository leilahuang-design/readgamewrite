---
import { TYPES, type ArticleType } from '../config';
import { img } from '../lib/content';
import { year } from '../lib/format';
import type { Article } from '../lib/types';

// RGW/Archive Toolbar + Year Heading + Archive Article + Archive Results.
interface Props {
  articles: Article[];
}
const { articles } = Astro.props;

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
const dayLabel = (d: string) => {
  const [, m, day] = d.split('-').map(Number);
  return `${MONTHS[m - 1]} ${day}`;
};

const years = [...new Set(articles.map((a) => year(a.date)))].sort((a, b) => b - a);
const typeOrder: ArticleType[] = ['books', 'games', 'essay'];
const presentTypes = typeOrder.filter((t) => articles.some((a) => a.type === t));

// Server-rendered list = "Newest first" with a heading each time the year changes
// (so the page is complete even without JavaScript).
const items: ({ heading: number } | { a: Article })[] = [];
articles.forEach((a, i) => {
  if (i === 0 || year(a.date) !== year(articles[i - 1].date)) items.push({ heading: year(a.date) });
  items.push({ a });
});

const searchText = (a: Article) => [a.title, a.summary, ...a.tags].join(' ').toLowerCase();
---

<section class="archive frame" data-archive>
  <div class="toolbar">
    <div class="filters">
      <label class="search">
        <span class="sr-only">Search articles</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path
            d="M14.0001 14.0001L11.1068 11.1068M12.6667 7.33333C12.6667 10.2789 10.2789 12.6667 7.33333 12.6667C4.38781 12.6667 2 10.2789 2 7.33333C2 4.38781 4.38781 2 7.33333 2C10.2789 2 12.6667 4.38781 12.6667 7.33333Z"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"></path>
        </svg>
        <input id="archive-search" type="search" placeholder="Search titles or tags" autocomplete="off" data-search />
      </label>

      <label class="select s-cat">
        <span class="sr-only">Category</span>
        <select data-category>
          <option value="all">All categories</option>
          {presentTypes.map((t) => <option value={t}>{TYPES[t].label}</option>)}
        </select>
        <svg class="chev" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
      </label>

      <label class="select s-year">
        <span class="sr-only">Year</span>
        <select data-year>
          <option value="all">All years</option>
          {years.map((y) => <option value={String(y)}>{y}</option>)}
        </select>
        <svg class="chev" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
      </label>

      <label class="select s-sort">
        <span class="sr-only">Sort</span>
        <select data-sort>
          <option value="newest">Newest first</option>
          <option value="oldest">Oldest first</option>
        </select>
        <svg class="chev" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path></svg>
      </label>
    </div>

    <div class="tabs" role="group" aria-label="Category">
      <button type="button" class="tab on" data-tab="all" aria-pressed="true">All writing</button>
      {presentTypes.map((t) => <button type="button" class="tab" data-tab={t} aria-pressed="false">{TYPES[t].label}</button>)}
    </div>
  </div>

  <div class="list" data-list>
    {
      items.map((it) =>
        'heading' in it ? (
          <h2 class="year" data-heading>{it.heading}</h2>
        ) : (
          <a
            class="row"
            href={`/articles/${it.a.slug}/`}
            data-row
            data-type={it.a.type}
            data-year={year(it.a.date)}
            data-ts={it.a.date}
            data-text={searchText(it.a)}
          >
            <div class="body">
              <div class="meta">
                <span class="tag">{TYPES[it.a.type].label}</span>
                <span>{it.a.minutes} min</span>
                <span>{dayLabel(it.a.date)}</span>
              </div>
              <h3 class="title">{it.a.title}</h3>
              {it.a.summary && <p class="summary">{it.a.summary}</p>}
            </div>
            {it.a.cover && (
              <div class="preview" aria-hidden="true">
                <img
                  src={img(it.a.cover.url, 264)}
                  alt=""
                  width="88"
                  height="132"
                  loading="lazy"
                  decoding="async"
                  style={it.a.cover.position ? `object-position:${it.a.cover.position}` : undefined}
                />
              </div>
            )}
          </a>
        ),
      )
    }
  </div>

  <p class="empty" data-empty hidden>No articles match your search.</p>

  <div class="results" aria-live="polite">
    <p data-count>Showing {articles.length} of {articles.length} entries</p>
    <p>You’re all caught up.</p>
  </div>
</section>

<style>
  .archive {
    padding-bottom: 0;
  }

  /* ── Toolbar ── */
  .toolbar {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .search,
  .select {
    position: relative;
    display: flex;
    align-items: center;
    height: 44px;
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    background: transparent;
    color: var(--text-muted);
    font-family: var(--font-ui);
    font-size: 13px;
  }
  .search {
    flex: 1 1 100%;
    gap: 10px;
    padding-inline: 14px;
  }
  .search input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: 0;
    outline: 0;
    background: transparent;
    font: inherit;
    color: var(--text-article);
  }
  .search input::placeholder {
    color: var(--text-muted);
  }
  .search input::-webkit-search-cancel-button {
    display: none;
  }
  .search:focus-within,
  .select:focus-within {
    border-color: var(--accent);
  }
  .select {
    flex: 1 1 140px;
    min-width: 0;
  }
  .select select {
    appearance: none;
    -webkit-appearance: none;
    width: 100%;
    height: 100%;
    padding: 0 34px 0 14px;
    border: 0;
    outline: 0;
    background: transparent;
    font: inherit;
    color: var(--text-article);
    cursor: pointer;
    border-radius: 6px;
  }
  .select select option {
    background: var(--surface-default);
    color: var(--text-article);
  }
  .chev {
    position: absolute;
    right: 14px;
    top: 50%;
    translate: 0 -50%;
    pointer-events: none;
    color: var(--text-muted);
  }

  .tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0 28px;
    border-bottom: 1px solid var(--border-subtle);
  }
  .tab {
    padding: 16px 0 12px;
    margin-bottom: -1px;
    border-bottom: 4px solid transparent;
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: 14px;
    line-height: normal;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .tab:hover {
    color: var(--text-primary);
  }
  .tab.on {
    color: var(--text-primary);
    border-bottom-color: var(--icon-default);
  }

  /* Tablet+: one row – search grows, selects keep Figma widths */
  @media (min-width: 768px) {
    .filters {
      flex-wrap: nowrap;
    }
    .search {
      flex: 1 1 0;
      min-width: 0;
    }
    .select {
      flex: none;
      min-width: 0;
    }
    .s-cat {
      width: clamp(132px, calc(132px + (100vw - 768px) * 0.0536), 168px);
    }
    .s-year {
      width: clamp(116px, calc(116px + (100vw - 768px) * 0.0179), 128px);
    }
    .s-sort {
      width: clamp(132px, calc(132px + (100vw - 768px) * 0.0476), 164px);
    }
  }

  /* ── Year heading ── */
  .year {
    padding: 36px 16px 12px;
    font-family: var(--font-ui);
    font-weight: 800;
    font-size: clamp(16px, calc(16px + (100vw - 390px) * 0.0019), 18px);
    line-height: normal;
    color: var(--text-heading);
  }
  .year[hidden] {
    display: none;
  }

  /* ── Article row ── */
  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 160px;
    padding: 24px 16px;
    border: 1px solid transparent;
    border-radius: 20px;
    transition: background 0.15s, border-color 0.15s;
  }
  .row[hidden] {
    display: none;
  }
  .body {
    flex: 1 1 auto;
    min-width: 0;
    max-width: 800px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 9px;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    font-family: var(--font-ui);
    font-size: 12px;
    line-height: normal;
    color: var(--text-article);
  }
  .title {
    font-family: var(--font-read);
    font-weight: 500;
    font-size: 16px;
    line-height: 24px;
    color: var(--text-article);
  }
  .summary {
    font-family: var(--font-read);
    font-size: 14px;
    line-height: 20px;
    color: var(--text-muted);
  }
  /* Hover / selected state (Figma "Archive Article · Selected") */
  .preview {
    display: none;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 176px;
    height: 154px;
  }
  .preview img {
    width: 88px;
    height: 132px;
    object-fit: cover;
    border-radius: 8px;
  }
  .row:hover,
  .row:focus-visible {
    background: var(--surface-selected);
    border-color: var(--accent);
    outline: none;
  }
  .row:hover .title,
  .row:focus-visible .title {
    color: var(--text-link);
  }
  @media (hover: hover) and (min-width: 768px) {
    .row:hover .preview,
    .row:focus-visible .preview {
      display: flex;
    }
  }

  @media (min-width: 768px) {
    .row {
      padding: 28px 32px;
      border-radius: 32px;
    }
    .title {
      font-size: clamp(18px, calc(18px + (100vw - 768px) * 0.00595), 22px);
      line-height: clamp(26px, calc(26px + (100vw - 768px) * 0.00877), 31.9px);
    }
    .summary {
      font-size: 16px;
      line-height: 32px;
    }
  }
  @media (min-width: 1024px) {
    .row {
      min-height: 210px;
    }
  }

  /* ── Results footer ── */
  .empty {
    padding: 48px 16px;
    font-family: var(--font-read);
    color: var(--text-muted);
  }
  .empty[hidden] {
    display: none;
  }
  .results {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding: 28px 0 clamp(32px, calc(32px + (100vw - 390px) * 0.038), 72px);
    font-family: var(--font-ui);
    font-size: 12px;
    line-height: normal;
    color: var(--text-muted);
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-archive]');
  if (root) {
    const list = root.querySelector<HTMLElement>('[data-list]')!;
    const rows = [...root.querySelectorAll<HTMLElement>('[data-row]')];
    const search = root.querySelector<HTMLInputElement>('[data-search]')!;
    const selCat = root.querySelector<HTMLSelectElement>('[data-category]')!;
    const selYear = root.querySelector<HTMLSelectElement>('[data-year]')!;
    const selSort = root.querySelector<HTMLSelectElement>('[data-sort]')!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const empty = root.querySelector<HTMLElement>('[data-empty]')!;
    // Clone of a server-rendered heading, so new headings keep the scoped styles.
    const headingProto = root.querySelector<HTMLElement>('[data-heading]')?.cloneNode(false) as HTMLElement | undefined;

    const setCategory = (value: string) => {
      selCat.value = [...selCat.options].some((o) => o.value === value) ? value : 'all';
      tabs.forEach((t) => {
        const on = t.dataset.tab === selCat.value;
        t.classList.toggle('on', on);
        t.setAttribute('aria-pressed', String(on));
      });
    };

    const render = () => {
      const q = search.value.trim().toLowerCase();
      const cat = selCat.value;
      const yr = selYear.value;
      const newestFirst = selSort.value === 'newest';

      root.querySelectorAll('[data-heading]').forEach((h) => h.remove());

      const visible = rows
        .filter((r) => {
          const ok =
            (cat === 'all' || r.dataset.type === cat) &&
            (yr === 'all' || r.dataset.year === yr) &&
            (!q || (r.dataset.text ?? '').includes(q));
          r.hidden = !ok;
          return ok;
        })
        .sort((a, b) => {
          const d = (a.dataset.ts ?? '').localeCompare(b.dataset.ts ?? '');
          return newestFirst ? -d : d;
        });

      // Re-insert rows in order, with a year heading each time the year changes.
      let lastYear = '';
      visible.forEach((r) => {
        if (r.dataset.year !== lastYear) {
          lastYear = r.dataset.year ?? '';
          if (headingProto) {
            const h = headingProto.cloneNode(false) as HTMLElement;
            h.textContent = lastYear;
            list.append(h);
          }
        }
        list.append(r);
      });
      rows.filter((r) => r.hidden).forEach((r) => list.append(r));

      count.textContent = `Showing ${visible.length} of ${rows.length} entries`;
      empty.hidden = visible.length > 0;
    };

    search.addEventListener('input', render);
    selCat.addEventListener('change', () => {
      setCategory(selCat.value);
      render();
    });
    selYear.addEventListener('change', render);
    selSort.addEventListener('change', render);
    tabs.forEach((t) =>
      t.addEventListener('click', () => {
        setCategory(t.dataset.tab ?? 'all');
        render();
      }),
    );

    // /articles/?type=books (also used by the old /books and /games URLs)
    const params = new URLSearchParams(location.search);
    const type = params.get('type');
    if (type) setCategory(type);
    const q = params.get('q');
    if (q) search.value = q;
    if (type || q) render();
    if (location.hash === '#search') search.focus();
  }
</script>
