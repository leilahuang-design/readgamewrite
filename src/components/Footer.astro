---
import { SITE } from '../config';

interface Props {
  instagramUrl?: string;
  threadsUrl?: string;
}
const { instagramUrl, threadsUrl } = Astro.props;
const internal = [
  { label: 'Home', href: '/' },
  { label: 'All Articles', href: '/articles/' },
  { label: 'About', href: '/about/' },
];
const external = [
  instagramUrl && { label: 'Instagram', href: instagramUrl },
  threadsUrl && { label: 'Threads', href: threadsUrl },
].filter(Boolean) as { label: string; href: string }[];
---

<footer class="closing">
  <div class="frame row">
    <p class="copy">© {SITE.year} {SITE.copyrightName}</p>
    <ul class="links" aria-label="Footer">
      {internal.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      {external.map((l) => <li><a href={l.href} target="_blank" rel="noopener noreferrer">{l.label}</a></li>)}
      <li><a href="#main" data-top>Top</a></li>
    </ul>
  </div>
</footer>

<style>
  .closing {
    background: var(--surface-default);
  }
  .row {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding-block: clamp(32px, calc(32px + (100vw - 390px) * 0.061), 96px);
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: var(--fs-footer);
    line-height: normal;
  }
  .copy {
    color: var(--text-muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
  }
  .links a {
    color: var(--text-primary);
  }
  .links a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  /* ≥ 640px: copyright left, links right (Figma desktop) */
  @media (min-width: 640px) {
    .row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
    }
    .links {
      justify-content: flex-end;
    }
  }
</style>

<script>
  document.querySelector('[data-top]')?.addEventListener('click', (e) => {
    e.preventDefault();
    window.scrollTo({ top: 0 });
  });
</script>
