---
import { SITE } from '../config';
---

<section class="callout" aria-labelledby="nl-title">
  <div class="copy">
    <p class="eyebrow">A LETTER EVERY OTHER SUNDAY</p>
    <h2 id="nl-title">每兩週，一封關於閱讀與遊戲的信。</h2>
  </div>
  <form class="field" action={SITE.newsletterUrl} method="post">
    <label class="sr-only" for="nl-email">Email</label>
    <input id="nl-email" type="email" name="email" placeholder="your@email.com" required autocomplete="email" />
    <button type="submit">Join →</button>
  </form>
</section>

<style>
  .callout {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    width: min(1120px, 100%);
    margin: 0 auto;
    padding: 38px 42px;
    background: var(--accent);
    color: #000;
    border-radius: 32px;
    box-shadow: var(--shadow-callout);
  }
  .eyebrow {
    font-size: 10px;
    font-weight: 800;
    margin-bottom: 7px;
  }
  h2 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 25px;
    line-height: 1.4;
  }
  .field {
    flex: none;
    width: 360px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2px;
    padding: 13px 18px;
    background: #fff;
    font-size: 12px;
  }
  input {
    border: 0;
    outline: 0;
    background: none;
    color: #111;
    font-size: 12px;
    padding: 0;
  }
  input::placeholder {
    color: #777772;
  }
  button {
    align-self: flex-start;
    font-weight: 800;
    font-size: 12px;
    color: #000;
  }
  .field:focus-within {
    outline: 2px solid #000;
    outline-offset: 2px;
  }
  @media (max-width: 900px) {
    .callout {
      flex-direction: column;
      align-items: stretch;
      padding: 28px 24px;
      border-radius: 24px;
    }
    .field {
      width: 100%;
    }
    h2 {
      font-size: 22px;
    }
  }
</style>
