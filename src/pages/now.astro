---
import Base from '../layouts/Base.astro';
import { getSettings } from '../lib/content';
import { longDate } from '../lib/format';

const s = await getSettings();
---

<Base title="Now" description="What I'm reading, playing and thinking about right now.">
  <section class="wrap">
    <p class="eyebrow">NOW{s.nowUpdated ? ` · UPDATED ${longDate(s.nowUpdated).toUpperCase()}` : ''}</p>
    <h1>現在</h1>
    <div class="prose" set:html={s.nowHtml} />
  </section>
</Base>

<style>
  .wrap {
    padding: 88px var(--pad) 120px;
    max-width: calc(720px + var(--pad) * 2);
  }
  .eyebrow {
    font-size: 11px;
    font-weight: 800;
    margin-bottom: 28px;
  }
  h1 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(34px, 5.6vw, 58px);
    line-height: 1.24;
    margin-bottom: 40px;
  }
  @media (max-width: 640px) {
    .wrap {
      padding-top: 48px;
    }
  }
</style>
