---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getArticles, getSettings } from '../lib/content';
import { SITE } from '../config';

const [articles, settings] = await Promise.all([getArticles(), getSettings()]);
const latest = articles.slice(0, 3);
---

<Base description={SITE.description}>
  <section class="intro frame">
    <h1 class="display">
      <span>Read, Game,</span>
      <span>And Write</span>
    </h1>
    <p class="lead">{settings.heroTagline}</p>
  </section>

  <section class="latest frame" aria-label="Latest articles">
    {latest.map((a) => <ArticleCard article={a} />)}
  </section>
</Base>

<style>
  .intro {
    display: flex;
    flex-direction: column;
    gap: clamp(12px, calc(12px + (100vw - 390px) * 0.0057), 18px);
    padding-top: clamp(24px, calc(24px + (100vw - 390px) * 0.0229), 48px);
    padding-bottom: clamp(16px, calc(16px + (100vw - 390px) * 0.0305), 48px);
    margin-bottom: clamp(24px, calc(24px + (100vw - 390px) * 0.0381), 64px);
  }
  .display {
    display: flex;
    flex-direction: column;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-display);
    line-height: normal;
    letter-spacing: 0;
    color: var(--text-heading);
  }
  /* Two lines on every breakpoint; "And Write" is never split. */
  .display span {
    white-space: nowrap;
  }
  .lead {
    font-family: var(--font-ui);
    font-weight: 800;
    font-size: var(--fs-lead);
    line-height: normal;
    color: var(--text-heading);
  }

  .latest {
    display: flex;
    flex-direction: column;
    gap: clamp(20px, calc(20px + (100vw - 390px) * 0.0152), 36px);
    padding-top: clamp(16px, calc(16px + (100vw - 390px) * 0.0533), 72px);
    padding-bottom: clamp(32px, calc(32px + (100vw - 390px) * 0.0381), 72px);
  }
</style>
