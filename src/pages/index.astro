---
import Base from '../layouts/Base.astro';
import NoteRow from '../components/NoteRow.astro';
import { getArticles, getFeatured, getSettings } from '../lib/content';
import { issueLabel } from '../lib/format';
import { SITE } from '../config';

const [articles, featured, settings] = await Promise.all([getArticles(), getFeatured(), getSettings()]);
// The featured piece already has the hero slot, so "Latest notes" lists the next three.
const latest = articles.filter((a) => a.slug !== featured?.slug).slice(0, 3);
---

<Base description={SITE.description}>
  <section class="hero">
    <div class="heading">
      <div class="masthead">
        <h1>{SITE.name}</h1>
        <p class="tagline">{settings.heroTagline}</p>
      </div>
      {
        featured && (
          <aside class="issue" aria-label="Featured">
            <p class="label">NEW{featured.issue ? ` / ${issueLabel(featured.issue).toUpperCase()}` : ''}</p>
            <p class="feature">{featured.title}</p>
            <a class="read" href={`/articles/${featured.slug}/`}>
              <b>Read</b>
              <span aria-hidden="true">→</span>
            </a>
          </aside>
        )
      }
    </div>
  </section>

  <section class="latest" aria-labelledby="latest-title">
    <div class="inner">
      <div class="head">
        <h2 id="latest-title">LATEST NOTES</h2>
        <a href="/articles/">All Articles ↗</a>
      </div>
      <div class="rows">
        {latest.map((a) => <NoteRow article={a} />)}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    background: var(--bg-alt);
    min-height: clamp(360px, 48vw, 691px);
    padding: 58px var(--pad) 54px;
  }
  .heading {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 48px;
  }
  .masthead {
    display: flex;
    flex-direction: column;
    gap: 18px;
    min-width: 0;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(38px, 6.2vw, 64px);
    line-height: normal;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .tagline {
    max-width: 820px;
    font-size: clamp(18px, 2.4vw, 28px);
    line-height: 1.25;
    color: var(--ink);
  }
  .issue {
    flex: none;
    width: 250px;
    display: flex;
    flex-direction: column;
    gap: 7px;
    align-items: flex-start;
  }
  .label {
    font-size: 10px;
    color: var(--ink);
  }
  .feature {
    font-family: var(--font-serif);
    font-size: 22px;
    line-height: 1.45;
    color: var(--ink);
    text-wrap: balance;
  }
  .read {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    font-size: 12px;
    color: var(--ink-2);
    padding-top: 6px;
  }
  .read span {
    font-size: 14px;
    transition: transform 0.2s;
  }
  .read:hover span {
    transform: translateX(4px);
  }

  .latest {
    background: var(--surface);
  }
  .inner {
    padding: 72px var(--pad);
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-bottom: 28px;
  }
  h2 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 28px;
    line-height: 1.4;
    color: var(--ink-2);
  }
  .head a {
    font-size: 12px;
    font-weight: 600;
    color: var(--muted-2);
  }
  .head a:hover {
    color: var(--ink);
  }
  .rows {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }

  @media (max-width: 900px) {
    .hero {
      min-height: 0;
      padding-bottom: 64px;
    }
    .heading {
      flex-direction: column;
      gap: 56px;
    }
    .issue {
      width: min(320px, 100%);
    }
  }
  @media (max-width: 640px) {
    .hero {
      padding-top: 40px;
    }
    .inner {
      padding-top: 48px;
      padding-bottom: 40px;
      gap: 16px;
    }
    h2 {
      font-size: 22px;
    }
  }
</style>
