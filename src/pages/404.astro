---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" noindex>
  <section class="wrap">
    <p class="eyebrow">404</p>
    <h1>這一頁不見了。</h1>
    <p class="lead">網址可能打錯了，或是這篇文章已經被移走。</p>
    <a class="btn" href="/articles/">All Articles →</a>
  </section>
</Base>

<style>
  .wrap {
    padding: 120px var(--pad);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }
  .eyebrow {
    font-size: 11px;
    font-weight: 800;
  }
  h1 {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: clamp(34px, 5.6vw, 58px);
    line-height: 1.24;
  }
  .lead {
    font-family: var(--font-serif);
    font-size: 18px;
    color: var(--muted);
  }
  .btn {
    margin-top: 12px;
    padding: 12px 24px;
    border: 1px solid var(--line);
    border-radius: 999px;
    font-size: 13px;
  }
  .btn:hover {
    background: var(--accent);
    color: var(--on-accent);
    border-color: var(--accent);
  }
</style>
