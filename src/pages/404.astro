---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" noindex>
  <header class="frame page-header">
    <h1 class="page-heading">404</h1>
  </header>
  <section class="frame wrap">
    <p class="lead">這一頁不見了。網址可能打錯了，或是這篇文章已經被移走。</p>
    <a class="back" href="/articles/">All Articles →</a>
  </section>
</Base>

<style>
  .wrap {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    padding-block: 24px 96px;
  }
  .lead {
    font-family: var(--font-read);
    font-size: 18px;
    line-height: 32px;
    color: var(--text-article);
  }
  .back {
    font-family: var(--font-ui);
    font-weight: 800;
    font-size: 18px;
    color: var(--text-heading);
    border-bottom: 2px solid currentColor;
  }
  .back:hover {
    color: var(--text-link);
  }
</style>
