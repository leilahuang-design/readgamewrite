---
import Base from '../layouts/Base.astro';
import { getSettings } from '../lib/content';

const s = await getSettings();
const paragraphs = s.aboutIntro.split(/\n+/).filter(Boolean);
---

<Base title="About" description={s.aboutIntro}>
  <header class="frame page-header">
    <h1 class="page-heading">About</h1>
  </header>
  <section class="frame content">
    {paragraphs.map((p) => <p>{p}</p>)}
  </section>
</Base>

<style>
  .content {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding-block: clamp(24px, calc(24px + (100vw - 390px) * 0.0229), 48px);
    max-width: 1440px;
  }
  .content p {
    max-width: 40em;
    font-family: var(--font-read);
    font-weight: 400;
    font-size: clamp(16px, calc(16px + (100vw - 390px) * 0.0076), 24px);
    line-height: 32px;
    color: var(--text-article);
  }
</style>
