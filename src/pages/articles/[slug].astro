---
import Base from '../../layouts/Base.astro';
import { TYPES } from '../../config';
import { getArticles, img } from '../../lib/content';
import { longDate } from '../../lib/format';

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((article) => {
    const others = articles.filter((x) => x.slug !== article.slug);
    // Related: same category first, then newest; three at most.
    const related = [...others.filter((x) => x.type === article.type), ...others.filter((x) => x.type !== article.type)].slice(0, 3);
    return { params: { slug: article.slug }, props: { article, related } };
  });
}

const { article: a, related } = Astro.props;
---

<Base
  title={a.title}
  description={a.summary || undefined}
  image={a.cover ? img(a.cover.url, 1200) : undefined}
  type="article"
>
  <article class="reading">
    <header class="head">
      <p class="meta">
        <span class="tag">{TYPES[a.type].label}</span>
        <span class="min">{a.minutes} min</span>
        <span class="date">{longDate(a.date)}</span>
      </p>
      <h1>{a.title}</h1>
    </header>

    <div class="prose" set:html={a.bodyHtml} />

    {
      related.length > 0 && (
        <section class="related" aria-labelledby="related-title">
          <h2 id="related-title">Related articles</h2>
          {related.map((r) => (
            <a class="r-row" href={`/articles/${r.slug}/`}>
              <div class="r-meta">
                <span class="tag">{TYPES[r.type].label}</span>
                <span>{longDate(r.date)}</span>
                <span>{r.minutes} min</span>
              </div>
              <div class="r-body">
                <p class="r-title">{r.title}</p>
                {r.summary && <p class="r-summary">{r.summary}</p>}
              </div>
            </a>
          ))}
        </section>
      )
    }
  </article>
</Base>

<style>
  .reading {
    width: 100%;
    /* 760px reading column (≈ 35–40 Chinese characters per line) */
    max-width: calc(760px + var(--pad) * 2);
    margin-inline: auto;
    padding: clamp(40px, calc(40px + (100vw - 390px) * 0.0457), 88px) var(--pad) clamp(48px, calc(48px + (100vw - 390px) * 0.0305), 80px);
    display: flex;
    flex-direction: column;
    gap: clamp(32px, calc(32px + (100vw - 390px) * 0.0152), 48px);
  }
  .head {
    display: flex;
    flex-direction: column;
    gap: clamp(32px, calc(32px + (100vw - 390px) * 0.0152), 48px);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    font-family: var(--font-ui);
    font-size: 12px;
    line-height: 20px;
  }
  .min {
    color: var(--text-heading);
  }
  .date {
    color: var(--text-secondary);
  }
  h1 {
    font-family: var(--font-read);
    font-weight: 700;
    font-size: clamp(30px, calc(30px + (100vw - 390px) * 0.0171), 48px);
    line-height: clamp(42px, calc(42px + (100vw - 390px) * 0.021), 64px);
    color: var(--text-heading);
  }

  /* Related articles */
  .related {
    display: flex;
    flex-direction: column;
    padding-top: 40px;
  }
  .related h2 {
    font-family: var(--font-ui);
    font-weight: 700;
    font-size: clamp(22px, calc(22px + (100vw - 390px) * 0.0019), 24px);
    line-height: 34px;
    color: var(--text-heading);
  }
  .r-row {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 20px 0;
    border-radius: 16px;
  }
  .r-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    font-family: var(--font-ui);
    font-size: 13px;
    line-height: 20px;
    color: var(--text-secondary);
  }
  .r-body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .r-title {
    font-family: var(--font-read);
    font-weight: 500;
    font-size: 18px;
    line-height: 28px;
    color: var(--text-article);
  }
  .r-summary {
    font-family: var(--font-read);
    font-size: 14px;
    line-height: 22px;
    color: var(--text-secondary);
  }
  .r-row:hover .r-title {
    color: var(--text-link);
  }

  @media (min-width: 768px) {
    .meta {
      font-size: 13px;
    }
    .r-row {
      flex-direction: row;
      align-items: flex-start;
      gap: 24px;
    }
    .r-meta {
      flex: none;
      width: 120px;
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
    .r-title {
      font-size: 22px;
      line-height: 31.9px;
    }
    .r-summary {
      font-size: 16px;
      line-height: 32px;
    }
  }
</style>
